<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- the office window loads the built-in server over http://localhost -->
  <!-- asked once per app: the first time you use "Open in Terminal" or "Open in iTerm", and when Spotify or Music plays while the office is open -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Agent Office brings the terminal tab of the agent you clicked to the front, and shows the song Spotify or Music is playing at the rooftop DJ booth.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
